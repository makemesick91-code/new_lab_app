# DaengtisiaMS Scanner Agent — example configuration.
# Copy to ".env" and adjust. NEVER put secrets or real KTP data here.

# --- Network (safe-by-default: loopback only) ---
SCANNER_AGENT_HOST=127.0.0.1
SCANNER_AGENT_PORT=17661

# Backend: mock | sane | naps2 | wia
SCANNER_AGENT_BACKEND=mock

# Comma-separated DaengtisiaMS origins allowed to call the agent. Explicit
# allowlist ONLY: nothing else is trusted, and NO wildcard is ever used — only
# exact matches are echoed. Each entry must be https://<DNS name>.
SCANNER_AGENT_ALLOWED_ORIGINS=https://daengtisia.online

# production (default) | development.
# Loopback origins (localhost / 127.0.0.1 / [::1]) are NEVER trusted implicitly.
# Only for a developer workstation: set development AND list the exact local
# origin above, e.g. ...,http://localhost:8000. Never on a clinic PC.
# SCANNER_AGENT_MODE=production

# Scanner command timeout (ms).
SCANNER_AGENT_TIMEOUT_MS=30000

# Default scan settings.
SCANNER_AGENT_DPI=200
SCANNER_AGENT_QUALITY=82
SCANNER_AGENT_MAX_WIDTH=1600

# Max request body size in bytes (the scan payload is tiny JSON).
SCANNER_AGENT_MAX_BODY_BYTES=1048576

# Optional: device / profile name for the selected backend.
# SCANNER_AGENT_DEVICE=epson2:libusb:001:002

# Optional: mock backend sample image (PNG or JPEG).
# Use only a synthetic placeholder — NEVER a real KTP scan.
# SCANNER_AGENT_MOCK_IMAGE=/path/to/placeholder.jpg

# --- Windows NAPS2 backend (prototype) ---
# SCANNER_AGENT_NAPS2_PATH=C:\Program Files\NAPS2\NAPS2.Console.exe
# SCANNER_AGENT_NAPS2_PROFILE=ktp

# --- Windows WIA backend (experimental) ---
# SCANNER_AGENT_WIA_SCRIPT=C:\path\to\wia-scan.ps1

[Unit]
# Daily schedule for daengtisiams-db-backup.service (ENT-12).
#
# 18:30 UTC is 02:30 WITA (UTC+8) — after the last clinic closes and before the
# first opens, so a dump never competes with clinical traffic. The UTC suffix is
# explicit so the schedule does not move if the host timezone ever changes.
#
# This is the schedule VERIFIED on the Biznet production host on 2026-11-04
# (DMS-DEV-INFRA-ALIGNMENT-PR-COMPLETION-1). The repository previously said
# 19:00 UTC / 03:00 WITA, so a reinstall from here would have silently moved the
# production backup. The repository records production; it does not reschedule
# it. Changing this value is an owner decision about the production backup
# window, never a side effect of an unrelated change.
#
# The BK-2 encrypted package timer (daengtisiams-bk2-package.timer, host-only,
# OnCalendar=*-*-* 02:30:00 Asia/Makassar) is scheduled for the same minute: it
# fires at 18:30:00 UTC and this timer up to 60 s later (RandomizedDelaySec). The
# two may run concurrently and that is acceptable — both only read the database.
# Measured 2026-11-03: BK-2 18:30:00-18:30:09 UTC, db-backup 18:30:27-18:30:28 UTC.
Description=Daily DaengtisiaMS database backup (ENT-12, 02:30 WITA = 18:30 UTC)

[Timer]
OnCalendar=*-*-* 18:30:00 UTC

# Persistent=true is the point of using a timer rather than cron: if the host
# was down or rebooting at 18:30 UTC, systemd runs the missed backup as soon as
# it is up again instead of silently skipping a day.
Persistent=true

# Small spread (matches production) so a backup never starts at the exact same
# instant as any other scheduled work on this host.
RandomizedDelaySec=60

# Firing precision only. This does NOT prevent overlap — that comes free from
# systemd, which will not re-run a service whose previous activation is still
# running. Loosening the accuracy simply lets systemd batch this wake-up with
# other timers instead of holding a precise-to-the-microsecond alarm.
AccuracySec=1min

Unit=daengtisiams-db-backup.service

[Install]
WantedBy=timers.target

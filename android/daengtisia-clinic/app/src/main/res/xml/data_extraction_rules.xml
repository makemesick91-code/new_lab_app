<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred. The Keystore identity is not
     exportable anyway, and clinic state must not ride to another device. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="sharedpref" /></device-transfer>
</data-extraction-rules>

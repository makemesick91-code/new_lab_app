# POST-RME-ODONTOGRAM-STABILIZATION-1 / FIX-02 — stray local SQLite database.
#
# config/database.php:37 resolves the sqlite connection's file from DB_DATABASE
# (`env('DB_DATABASE', database_path('database.sqlite'))`). A local environment
# file legitimately sets DB_DATABASE to the PostgreSQL database NAME
# `asia_dental_lab`, so any command run with DB_CONNECTION=sqlite resolves that
# name as a RELATIVE path and creates a database file of that name in the
# working directory — which is how a 2.9MB schema-only artifact came to be
# committed at the repository root.
#
# Anchored to the root so it can never mask a legitimately named file elsewhere.
# It cannot be a *.sqlite / *.db pattern: the file has no extension.
# The PostgreSQL database NAME of the same spelling is untouched by this.
/asia_dental_lab

# FEATURE-DOCTOR-TRUSTED-ANDROID-DEVICE-LOCK-1 Phase 3 — Android build outputs.
# Sources and the Gradle wrapper are tracked; build products and local SDK
# pointers are not. No APK is committed: it is a build artifact, and a debug
# APK must never be mistaken for a release under production signing governance.
android/**/build/
android/**/.gradle/
android/**/local.properties
android/**/*.apk
# apksigner writes this beside every signed APK (v4 signature scheme).
android/**/*.idsig
android/**/*.aab
android/**/*.jks
android/**/*.keystore

# Phase 3.5 — the rest of the key-material surface. The upload keystore lives
# in custodian custody (docs/governance/android-production-signing-governance.md);
# nothing here may ever be staged. Signing credentials in a properties file are
# the same secret as the keystore, and a keystore beside its password is a
# keystore with no password.
android/**/*.p12
android/**/*.pfx
android/**/keystore.properties
android/**/signing.properties

APP_NAME="Asia Dental Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=asia_dental_lab
DB_USERNAME=postgres
DB_PASSWORD=postgres

# REPLICA-1 — read replica readiness (audit only; runtime reads stay on primary).
# See docs/architecture/read-replica-readiness.md before enabling.
DB_REPLICA_ENABLED=false
DB_REPLICA_EXPECTED=false
DB_REPLICA_STRICT=false
DB_REPLICA_CONNECTION=pgsql_read
DB_REPLICA_MAX_LAG_SECONDS=5
DB_REPLICA_CONNECT_TIMEOUT_SECONDS=2
DB_REPLICA_QUERY_TIMEOUT_MS=1500
DB_REPLICA_EXPECT_READ_ONLY=true
DB_REPLICA_HEALTHCHECK_ENABLED=true
DB_REPLICA_HEALTHCHECK_DEEP=false
DB_REPLICA_ALLOW_REPORTING_READS=false
DB_REPLICA_FAIL_ON_LAG=false
DB_READ_HOST=
DB_READ_PORT=5432
DB_READ_DATABASE=
DB_READ_USERNAME=
DB_READ_PASSWORD=
DB_READ_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# CACHE-1 — Redis shared cache & session readiness (audit only; never switches
# CACHE_STORE/SESSION_DRIVER by itself). See
# docs/architecture/redis-shared-cache-session-readiness.md before enabling.
CACHE_REDIS_READINESS_ENABLED=true
CACHE_REDIS_EXPECTED=false
CACHE_REDIS_STRICT=false
CACHE_REDIS_CONNECTION=cache
CACHE_REDIS_SESSION_CONNECTION=session
CACHE_REDIS_HEALTHCHECK_ENABLED=true
CACHE_REDIS_HEALTHCHECK_PREFIX=healthchecks:cache
CACHE_REDIS_CONNECT_TIMEOUT_SECONDS=2
CACHE_REDIS_OPERATION_TIMEOUT_MS=1500
CACHE_REDIS_TTL_SECONDS=30
CACHE_REDIS_EXPECT_CACHE_STORE=false
CACHE_REDIS_EXPECT_SESSION_DRIVER=false
CACHE_REDIS_EXPECT_LOCKS=false
CACHE_REDIS_FAIL_ON_LOCAL_CACHE=false
CACHE_REDIS_FAIL_ON_LOCAL_SESSION=false
CACHE_REDIS_ALLOW_SINGLE_VPS_WARNINGS=true

OBSERVABILITY_ENABLED=true
OBSERVABILITY_REQUEST_ID_ENABLED=true
OBSERVABILITY_REQUEST_ID_HEADER=X-Request-ID
OBSERVABILITY_CORRELATION_ID_HEADER=X-Correlation-ID
OBSERVABILITY_RESPONSE_HEADER=X-Request-ID
OBSERVABILITY_TRUST_INBOUND_REQUEST_ID=false
OBSERVABILITY_TRUST_INBOUND_CORRELATION_ID=false
OBSERVABILITY_MAX_ID_LENGTH=80
OBSERVABILITY_LOG_CONTEXT_ENABLED=true
OBSERVABILITY_LOG_ROUTE_NAME=true
OBSERVABILITY_LOG_METHOD=true
OBSERVABILITY_LOG_PATH=true
OBSERVABILITY_LOG_USER_ID=false
OBSERVABILITY_LOG_BRANCH_ID=false
OBSERVABILITY_MASK_PII=true
OBSERVABILITY_HEALTHCHECK_ENABLED=true
OBSERVABILITY_STRICT=false

OBS_PIPELINE_ENABLED=true
CENTRAL_LOGGING_ENABLED=false
CENTRAL_LOGGING_DRIVER=none
CENTRAL_LOGGING_ENDPOINT=
CENTRAL_LOGGING_API_KEY=
CENTRAL_LOGGING_TIMEOUT_MS=1500
CENTRAL_LOGGING_EXPECT_REQUEST_ID=true
CENTRAL_LOGGING_SEND_PII=false
CENTRAL_LOGGING_STRICT=false
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DRIVER=none
ERROR_TRACKING_DSN=
ERROR_TRACKING_ENVIRONMENT=pilot
ERROR_TRACKING_SAMPLE_RATE=0.0
ERROR_TRACKING_SEND_PII=false
ERROR_TRACKING_EXPECT_REQUEST_ID=true
ERROR_TRACKING_STRICT=false
OBS_PIPELINE_HEALTHCHECK_ENABLED=true
OBS_PIPELINE_LOG_SMOKE_ENABLED=true
OBS_PIPELINE_ERROR_SMOKE_ENABLED=false
OBS_PIPELINE_FAIL_ON_PII_RISK=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# STORAGE-1 — object storage readiness (OFF by default; no production file migration).
# See docs/architecture/storage-object-readiness.md before enabling.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_DISK=object
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true
OBJECT_STORAGE_THROW=true
OBJECT_STORAGE_HEALTHCHECK_PREFIX=healthchecks/daengtisiams

# STATELESS-1 — runtime statelessness & deploy portability readiness (audit only).
# See docs/architecture/runtime-statelessness-readiness.md. Never changes any driver.
STATELESS_READINESS_ENABLED=true
STATELESS_EXPECT_SHARED_SESSIONS=false
STATELESS_EXPECT_SHARED_CACHE=false
STATELESS_EXPECT_ASYNC_QUEUE=false
STATELESS_EXPECT_OBJECT_STORAGE=false
STATELESS_ALLOWED_LOCAL_WRITE_PATHS=storage,bootstrap/cache
STATELESS_HEALTHCHECK_DISK=local
STATELESS_HEALTHCHECK_PREFIX=healthchecks/stateless
STATELESS_STRICT=false

# LB-1 — load balancer pilot readiness (audit + minimal health endpoint only).
# See docs/architecture/load-balancer-pilot-readiness.md. Never forces a
# trusted-proxy/HTTPS/secure-cookie change by itself.
LB_PILOT_ENABLED=true
LB_TRUSTED_PROXIES=
LB_EXPECT_FORWARDED_HEADERS=false
LB_EXPECT_HTTPS=false
LB_EXPECT_SECURE_COOKIES=false
LB_HEALTH_ENDPOINT_ENABLED=true
LB_HEALTH_ENDPOINT_PATH=/health/lb
LB_HEALTH_DEEP_CHECK=false
LB_HEADER_SMOKE_ENABLED=true
LB_STRICT=false

VITE_APP_NAME="${APP_NAME}"

# Sprint 16.8 — inventory analytics summary tables (default false = live ledger repository)
INVENTORY_ANALYTICS_SUMMARY_ENABLED=false
# Retention for daily/procurement rpt_* rows only (default 730 days); prune is optional via artisan command
INVENTORY_ANALYTICS_SUMMARY_RETENTION_DAYS=730
